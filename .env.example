# Copy to .env and adjust as needed
ENV=local

# DynamoDB Local (docker-compose up)
DYNAMODB_TABLE_NAME=monopoly
DYNAMODB_ENDPOINT_URL=http://localhost:8002
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Production only — API Gateway Management API endpoint
# APIGW_MANAGEMENT_ENDPOINT=https://{api-id}.execute-api.{region}.amazonaws.com/{stage}

# PostgreSQL (docker-compose up)
DATABASE_URL=postgresql+asyncpg://monopoly:monopoly@localhost:5432/monopoly

# JWT RS256 keys — generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# OAuth (optional for local dev)
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
