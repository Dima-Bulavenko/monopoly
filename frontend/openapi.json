{
  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "description": "Public API response \u2014 only the short-lived access token.\n\nThe refresh token is delivered via an httpOnly cookie by the router.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "AccessTokenResponse",
        "type": "object"
      },
      "BoardResponse": {
        "properties": {
          "board": {
            "items": {
              "discriminator": {
                "mapping": {
                  "chance": "#/components/schemas/Square",
                  "community_chest": "#/components/schemas/Square",
                  "free_parking": "#/components/schemas/Square",
                  "go": "#/components/schemas/Square",
                  "go_to_jail": "#/components/schemas/Square",
                  "jail": "#/components/schemas/Square",
                  "property": "#/components/schemas/PropertySquare",
                  "railroad": "#/components/schemas/RailroadSquare",
                  "tax": "#/components/schemas/TaxSquare",
                  "utility": "#/components/schemas/UtilitySquare"
                },
                "propertyName": "square_type"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/PropertySquare"
                },
                {
                  "$ref": "#/components/schemas/RailroadSquare"
                },
                {
                  "$ref": "#/components/schemas/UtilitySquare"
                },
                {
                  "$ref": "#/components/schemas/TaxSquare"
                },
                {
                  "$ref": "#/components/schemas/Square"
                }
              ]
            },
            "title": "Board",
            "type": "array"
          }
        },
        "required": [
          "board"
        ],
        "title": "BoardResponse",
        "type": "object"
      },
      "ColorGroup": {
        "enum": [
          "brown",
          "light_blue",
          "pink",
          "orange",
          "red",
          "yellow",
          "green",
          "dark_blue"
        ],
        "title": "ColorGroup",
        "type": "string"
      },
      "CreateGameDTO": {
        "properties": {
          "max_players": {
            "maximum": 6.0,
            "minimum": 2.0,
            "title": "Max Players",
            "type": "integer"
          }
        },
        "required": [
          "max_players"
        ],
        "title": "CreateGameDTO",
        "type": "object"
      },
      "ErrorResponseModel": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponseModel",
        "type": "object"
      },
      "GameStatus": {
        "enum": [
          "lobby",
          "in_progress",
          "finished"
        ],
        "title": "GameStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "OAuthLoginRequest": {
        "properties": {
          "device_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Hint"
          },
          "id_token": {
            "title": "Id Token",
            "type": "string"
          }
        },
        "required": [
          "id_token"
        ],
        "title": "OAuthLoginRequest",
        "type": "object"
      },
      "Player": {
        "properties": {
          "balance": {
            "default": 1500,
            "title": "Balance",
            "type": "integer"
          },
          "consecutive_doubles": {
            "default": 0,
            "title": "Consecutive Doubles",
            "type": "integer"
          },
          "get_out_of_jail_cards": {
            "default": 0,
            "title": "Get Out Of Jail Cards",
            "type": "integer"
          },
          "in_jail": {
            "default": false,
            "title": "In Jail",
            "type": "boolean"
          },
          "is_bankrupt": {
            "default": false,
            "title": "Is Bankrupt",
            "type": "boolean"
          },
          "jail_turns": {
            "default": 0,
            "title": "Jail Turns",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "player_id": {
            "title": "Player Id",
            "type": "string"
          },
          "position": {
            "default": 0,
            "title": "Position",
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "title": "Player",
        "type": "object"
      },
      "PropertySquare": {
        "description": "A colour-group property.",
        "properties": {
          "color_group": {
            "$ref": "#/components/schemas/ColorGroup"
          },
          "house_cost": {
            "title": "House Cost",
            "type": "integer"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "mortgage_value": {
            "title": "Mortgage Value",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price": {
            "title": "Price",
            "type": "integer"
          },
          "rent": {
            "items": {
              "type": "integer"
            },
            "title": "Rent",
            "type": "array"
          },
          "square_type": {
            "const": "property",
            "default": "property",
            "title": "Square Type",
            "type": "string"
          }
        },
        "required": [
          "index",
          "name",
          "color_group",
          "price",
          "rent",
          "house_cost",
          "mortgage_value"
        ],
        "title": "PropertySquare",
        "type": "object"
      },
      "RailroadSquare": {
        "properties": {
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "mortgage_value": {
            "title": "Mortgage Value",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price": {
            "title": "Price",
            "type": "integer"
          },
          "square_type": {
            "const": "railroad",
            "default": "railroad",
            "title": "Square Type",
            "type": "string"
          }
        },
        "required": [
          "index",
          "name",
          "price",
          "mortgage_value"
        ],
        "title": "RailroadSquare",
        "type": "object"
      },
      "ReadGameDTO": {
        "properties": {
          "game_id": {
            "title": "Game Id",
            "type": "string"
          },
          "max_players": {
            "maximum": 6.0,
            "minimum": 2.0,
            "title": "Max Players",
            "type": "integer"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/Player"
            },
            "title": "Players",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/GameStatus"
          }
        },
        "required": [
          "game_id",
          "players",
          "status",
          "max_players"
        ],
        "title": "ReadGameDTO",
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "display_name"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "Square": {
        "properties": {
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "square_type": {
            "enum": [
              "go",
              "community_chest",
              "chance",
              "jail",
              "free_parking",
              "go_to_jail"
            ],
            "title": "Square Type",
            "type": "string"
          }
        },
        "required": [
          "index",
          "name",
          "square_type"
        ],
        "title": "Square",
        "type": "object"
      },
      "TaxSquare": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "integer"
          },
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "square_type": {
            "const": "tax",
            "default": "tax",
            "title": "Square Type",
            "type": "string"
          }
        },
        "required": [
          "index",
          "name",
          "amount"
        ],
        "title": "TaxSquare",
        "type": "object"
      },
      "UtilitySquare": {
        "properties": {
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "mortgage_value": {
            "title": "Mortgage Value",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price": {
            "title": "Price",
            "type": "integer"
          },
          "square_type": {
            "const": "utility",
            "default": "utility",
            "title": "Square Type",
            "type": "string"
          }
        },
        "required": [
          "index",
          "name",
          "price",
          "mortgage_value"
        ],
        "title": "UtilitySquare",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "_ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "_ErrorResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "API for managing a Monopoly game, including players, properties, and game state.",
    "title": "Monopoly API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/apple": {
      "post": {
        "operationId": "login_apple",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OAuthLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/_ErrorResponse"
                }
              }
            },
            "description": "Authentication failed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login Apple",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/google": {
      "post": {
        "operationId": "login_google",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OAuthLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/_ErrorResponse"
                }
              }
            },
            "description": "Authentication failed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login Google",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/_ErrorResponse"
                }
              }
            },
            "description": "Authentication failed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "in": "cookie",
            "name": "refresh_token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "parameters": [
          {
            "in": "cookie",
            "name": "refresh_token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/_ErrorResponse"
                }
              }
            },
            "description": "Refresh token expired or invalid"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/_ErrorResponse"
                }
              }
            },
            "description": "Email already registered"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/board/": {
      "get": {
        "operationId": "get_board",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Board",
        "tags": [
          "board"
        ]
      }
    },
    "/games/": {
      "post": {
        "operationId": "create_game",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGameDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadGameDTO"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseModel"
                }
              }
            },
            "description": "Game already exists"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Game",
        "tags": [
          "games"
        ]
      }
    },
    "/games/{game_id}": {
      "get": {
        "operationId": "get_game",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadGameDTO"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseModel"
                }
              }
            },
            "description": "Game not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Game",
        "tags": [
          "games"
        ]
      }
    },
    "/games/{game_id}/join": {
      "patch": {
        "operationId": "join_game",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadGameDTO"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseModel"
                }
              }
            },
            "description": "Game not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Join Game",
        "tags": [
          "games"
        ]
      }
    }
  }
}
